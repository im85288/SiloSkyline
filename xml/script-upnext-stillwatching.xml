<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_upnext.py: Up Next asks before it plays another episode.
     Silo's Next Up: the next episode's card, details and buttons along the
     bottom over a dark scrim. -->
<window>
    <defaultcontrol always="true">3012</defaultcontrol>
    <zorder>1</zorder>
    <controls>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="240">WindowClose</animation>
            <control type="image">
                <left>0</left><bottom>0</bottom>
                <width>1920</width><height>720</height>
                <texture>silo/scrim_bottom.png</texture>
            </control>
        </control>
        <control type="group">
            <left>88</left><bottom>96</bottom>
            <width>1744</width><height>315</height>
            <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
            <animation effect="slide" start="0,60" end="0,0" time="300" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="240">WindowClose</animation>
            <!-- The next episode's still (else the show's art), with a hairline edge. -->
            <control type="image">
                <width>560</width><height>315</height>
                <texture diffuse="silo/card_landscape_mask.png" colordiffuse="FF1A1D27">colors/white.png</texture>
            </control>
            <control type="image">
                <width>560</width><height>315</height>
                <aspectratio>scale</aspectratio>
                <texture background="true" diffuse="silo/card_landscape_mask.png">$VAR[SiloUpNextArt]</texture>
            </control>
            <control type="image">
                <width>560</width><height>315</height>
                <texture diffuse="silo/card_landscape_mask.png">silo/card_scrim.png</texture>
            </control>
            <control type="progress" id="3014">
                <left>18</left><top>309</top>
                <width>524</width><height>6</height>
                <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                <lefttexture /><righttexture /><overlaytexture />
                <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
            </control>
            <!-- The details. -->
            <control type="label">
                <left>608</left><top>0</top>
                <width>1136</width><height>36</height>
                <aligny>center</aligny>
                <font>silo_badge</font>
                <textcolor>85EDEDED</textcolor>
                <label>$ADDON[service.upnext 30024]</label>
            </control>
            <control type="label">
                <left>608</left><top>40</top>
                <width>1136</width><height>56</height>
                <aligny>center</aligny>
                <font>silo_wordmark</font>
                <textcolor>FFEDEDED</textcolor>
                <label>$INFO[Window.Property(tvshowtitle)]</label>
            </control>
            <control type="label">
                <left>608</left><top>100</top>
                <width>1136</width><height>40</height>
                <aligny>center</aligny>
                <font>silo_meta</font>
                <textcolor>C7EDEDED</textcolor>
                <label>$INFO[Window.Property(season),S,]$INFO[Window.Property(episode),·E,  ][COLOR FFEDEDED]$INFO[Window.Property(title)][/COLOR]$INFO[Window.Property(endtime),  ·  Ends at ,]</label>
            </control>
            <control type="textbox">
                <left>608</left><top>148</top>
                <width>1000</width><height>62</height>
                <font>silo_detail</font>
                <textcolor>94EDEDED</textcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <autoscroll>false</autoscroll>
            </control>
            <control type="grouplist" id="3000">
                <left>608</left><top>235</top>
                <width>1000</width><height>80</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <control type="button" id="3012">
                    <width>340</width><height>80</height>
                    <label>$ADDON[service.upnext 30010]</label>
                    <font>silo_meta</font>
                    <textcolor>FFEDEDED</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align><aligny>center</aligny>
                    <texturefocus border="46" colordiffuse="FFEDEDED">silo/dialog_button.png</texturefocus>
                    <texturenofocus border="46" colordiffuse="26FFFFFF">silo/dialog_button.png</texturenofocus>
                    <pulseonselect>false</pulseonselect>
                    <onright>3013</onright>
                </control>
                <control type="button" id="3013">
                    <width>220</width><height>80</height>
                    <label>$ADDON[service.upnext 30034]</label>
                    <font>silo_meta</font>
                    <textcolor>FFEDEDED</textcolor>
                    <focusedcolor>FF000000</focusedcolor>
                    <align>center</align><aligny>center</aligny>
                    <texturefocus border="46" colordiffuse="FFEDEDED">silo/dialog_button.png</texturefocus>
                    <texturenofocus border="46" colordiffuse="26FFFFFF">silo/dialog_button.png</texturenofocus>
                    <pulseonselect>false</pulseonselect>
                    <onleft>3012</onleft>
                </control>
            </control>
        </control>
    </controls>
</window>
