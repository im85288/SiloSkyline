<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_upnext.py: Up Next offers the next episode as this one ends.
     Silo TV's Next Up, full screen: the next episode's art behind, its still
     where Silo frames the playing video (Kodi can't frame it in a dialog),
     and the details and buttons beside it, top right. -->
<window>
    <defaultcontrol always="true">3012</defaultcontrol>
    <zorder>1</zorder>
    <controls>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="240">WindowClose</animation>
            <control type="image">
                <width>1920</width><height>1080</height>
                <texture colordiffuse="SkylineBackground">colors/white.png</texture>
            </control>
            <control type="image">
                <width>1920</width><height>1080</height>
                <aspectratio>scale</aspectratio>
                <texture background="true" colordiffuse="59FFFFFF">$VAR[SiloUpNextBackdrop]</texture>
            </control>
            <control type="image">
                <left>0</left><bottom>0</bottom>
                <width>1920</width><height>720</height>
                <texture>silo/scrim_bottom.png</texture>
            </control>
        </control>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
            <animation effect="slide" start="0,40" end="0,0" time="300" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="240">WindowClose</animation>
            <!-- The pane: the next episode's still with a hairline edge, and the countdown. -->
            <control type="image">
                <left>160</left><top>190</top>
                <width>616</width><height>346</height>
                <texture diffuse="silo/card_landscape_mask.png" colordiffuse="SkylineCard">colors/white.png</texture>
            </control>
            <control type="image">
                <left>160</left><top>190</top>
                <width>616</width><height>346</height>
                <aspectratio>scale</aspectratio>
                <texture background="true" diffuse="silo/card_landscape_mask.png">$VAR[SiloUpNextArt]</texture>
            </control>
            <control type="image">
                <left>160</left><top>190</top>
                <width>616</width><height>346</height>
                <texture diffuse="silo/card_landscape_mask.png">silo/card_scrim.png</texture>
            </control>
            <control type="image">
                <left>160</left><top>190</top>
                <width>616</width><height>346</height>
                <texture border="14" colordiffuse="29FFFFFF">silo/card_landscape_focus.png</texture>
            </control>
            <control type="progress" id="3014">
                <left>178</left><top>530</top>
                <width>580</width><height>6</height>
                <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                <lefttexture /><righttexture /><overlaytexture />
                <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
            </control>
            <!-- The panel. -->
            <control type="label">
                <left>816</left><top>200</top>
                <width>944</width><height>36</height>
                <aligny>center</aligny>
                <font>silo_meta</font>
                <textcolor>85EDEDED</textcolor>
                <label>UP NEXT</label>
                <visible>!String.IsEqual(Window.Property(credits_countdown),true) + Integer.IsGreater(Player.TimeRemaining,59)</visible>
            </control>
            <control type="label">
                <left>816</left><top>200</top>
                <width>944</width><height>36</height>
                <aligny>center</aligny>
                <font>silo_meta</font>
                <textcolor>85EDEDED</textcolor>
                <label>UP NEXT IN $INFO[Window.Property(remaining)] S</label>
                <visible>!String.IsEqual(Window.Property(credits_countdown),true) + !Integer.IsGreater(Player.TimeRemaining,59)</visible>
            </control>
            <control type="label" id="3015">
                <left>816</left><top>200</top>
                <width>944</width><height>36</height>
                <aligny>center</aligny>
                <font>silo_meta</font>
                <textcolor>85EDEDED</textcolor>
                <label>$ADDON[service.upnext 30050]  ·  $ADDON[service.upnext 30051]</label>
                <visible>String.IsEqual(Window.Property(credits_countdown),true)</visible>
                <description>credits countdown</description>
            </control>
            <control type="label">
                <left>816</left><top>244</top>
                <width>944</width><height>60</height>
                <aligny>center</aligny>
                <font>silo_wordmark</font>
                <textcolor>FFEDEDED</textcolor>
                <label>$INFO[Window.Property(tvshowtitle)]</label>
            </control>
            <control type="label">
                <left>816</left><top>310</top>
                <width>944</width><height>40</height>
                <aligny>center</aligny>
                <font>silo_meta</font>
                <textcolor>9EEDEDED</textcolor>
                <label>$INFO[Window.Property(season),S,]$INFO[Window.Property(episode),·E,  ][COLOR FFEDEDED]$INFO[Window.Property(title)][/COLOR]$INFO[Window.Property(endtime),  ·  Ends at ,]</label>
            </control>
            <control type="textbox">
                <left>816</left><top>362</top>
                <width>944</width><height>62</height>
                <font>silo_detail</font>
                <textcolor>94EDEDED</textcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <autoscroll>false</autoscroll>
            </control>
            <control type="grouplist" id="3000">
                <left>816</left><top>456</top>
                <width>944</width><height>80</height>
                <orientation>horizontal</orientation>
                <itemgap>20</itemgap>
                <control type="button" id="3012">
                    <width>340</width><height>80</height>
                    <label>Play Now</label>
                    <font>silo_meta</font>
                    <textcolor>FFEDEDED</textcolor>
                    <focusedcolor>SkylineFocusText</focusedcolor>
                    <align>center</align><aligny>center</aligny>
                    <texturefocus border="46" colordiffuse="SkylineFocus">silo/dialog_button.png</texturefocus>
                    <texturenofocus border="46" colordiffuse="26FFFFFF">silo/dialog_button.png</texturenofocus>
                    <pulseonselect>false</pulseonselect>
                    <onright>3013</onright>
                    <ondown>SetProperty(silo.deck,1)</ondown>
                    <ondown>SetFocus(3100)</ondown>
                </control>
                <control type="button" id="3013">
                    <width>220</width><height>80</height>
                    <label>$ADDON[service.upnext 30034]</label>
                    <font>silo_meta</font>
                    <textcolor>FFEDEDED</textcolor>
                    <focusedcolor>SkylineFocusText</focusedcolor>
                    <align>center</align><aligny>center</aligny>
                    <texturefocus border="46" colordiffuse="SkylineFocus">silo/dialog_button.png</texturefocus>
                    <texturenofocus border="46" colordiffuse="26FFFFFF">silo/dialog_button.png</texturenofocus>
                    <pulseonselect>false</pulseonselect>
                    <onleft>3012</onleft>
                    <ondown>SetProperty(silo.deck,1)</ondown>
                    <ondown>SetFocus(3100)</ondown>
                </control>
            </control>
            <!-- On Deck: the rest of Continue Watching. -->
            <control type="label">
                <left>160</left><top>592</top>
                <width>1200</width><height>46</height>
                <font>silo_row</font>
                <textcolor>FFEDEDED</textcolor>
                <label>Continue Watching</label>
                <visible>Integer.IsGreater(Container(3100).NumItems,0) | Container(3100).IsUpdating</visible>
            </control>
            <control type="list" id="3100">
                <left>154</left><top>648</top>
                <width>1766</width><height>250</height>
                <orientation>horizontal</orientation>
                <scrolltime tween="cubic" easing="out">280</scrolltime>
                <onup>ClearProperty(silo.deck)</onup>
                <onup>SetFocus(3012)</onup>
                <visible>Integer.IsGreater(Container(3100).NumItems,0) | Container(3100).IsUpdating</visible>
                <onfocus condition="!String.IsEqual(Window.Property(silo.deck),1)">SetFocus(3012)</onfocus>
                <onclick condition="Integer.IsGreater(ListItem.PercentPlayed,0)">PlayMedia($ESCINFO[ListItem.FileNameAndPath],resume)</onclick>
                <onclick condition="!Integer.IsGreater(ListItem.PercentPlayed,0)">PlayMedia($ESCINFO[ListItem.FileNameAndPath],noresume)</onclick>
                <content target="videos">plugin://plugin.video.silokodiconnect/?mode=widget&amp;section=continue_watching&amp;refresh=$INFO[Window(Home).Property(silokodi.library_updated)]&amp;exclude_show=$INFO[Window.Property(tvshowtitle)]</content>
                <itemlayout width="328" height="250">
                    <control type="group">
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>288</width><height>162</height>
                            <texture background="true" diffuse="silo/card_landscape_mask.png" fallback="colors/grey.png">$VAR[SiloLandscapeArt]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>288</width><height>162</height>
                            <texture diffuse="silo/card_landscape_mask.png">silo/card_scrim.png</texture>
                        </control>
                        <control type="progress">
                            <left>26</left><top>162</top>
                            <width>248</width><height>6</height>
                            <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                            <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                            <info>ListItem.PercentPlayed</info>
                            <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                        </control>
                        <control type="progress">
                            <left>26</left><top>162</top>
                            <width>248</width><height>6</height>
                            <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                            <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                            <info>ListItem.Property(home.percent)</info>
                            <visible>!String.IsEmpty(ListItem.Property(home.percent))</visible>
                        </control>
                        <control type="group">
                            <left>244</left><top>16</top>
                            <visible>Integer.IsGreater(ListItem.PlayCount,0) | !String.IsEmpty(ListItem.Property(home.playcount))</visible>
                            <control type="image">
                                <width>40</width><height>40</height>
                                <texture colordiffuse="F2EDEDED">silo/avatar_mask.png</texture>
                            </control>
                            <control type="image">
                                <left>9</left><top>9</top><width>22</width><height>22</height>
                                <texture colordiffuse="FF000000">OverlayWatched.png</texture>
                            </control>
                        </control>
                        <control type="label">
                            <left>6</left><top>182</top>
                            <width>288</width><height>34</height>
                            <font>silo_card_title</font>
                            <textcolor>66EDEDED</textcolor>
                            <label>$VAR[SiloCardTitle]</label>
                        </control>
                        <control type="label">
                            <left>6</left><top>216</top>
                            <width>288</width><height>32</height>
                            <font>silo_card_sub</font>
                            <textcolor>4AEDEDED</textcolor>
                            <label>$VAR[SiloCardEpisode]</label>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout width="328" height="250">
                    <control type="group">
                        <animation effect="zoom" start="100" end="110" time="180" tween="sine" easing="out" center="auto" condition="Control.HasFocus(3100)">Conditional</animation>
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>288</width><height>162</height>
                            <texture background="true" diffuse="silo/card_landscape_mask.png" fallback="colors/grey.png">$VAR[SiloLandscapeArt]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>288</width><height>162</height>
                            <texture diffuse="silo/card_landscape_mask.png">silo/card_scrim.png</texture>
                        </control>
                        <control type="progress">
                            <left>26</left><top>162</top>
                            <width>248</width><height>6</height>
                            <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                            <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                            <info>ListItem.PercentPlayed</info>
                            <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                        </control>
                        <control type="progress">
                            <left>26</left><top>162</top>
                            <width>248</width><height>6</height>
                            <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                            <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                            <info>ListItem.Property(home.percent)</info>
                            <visible>!String.IsEmpty(ListItem.Property(home.percent))</visible>
                        </control>
                        <control type="group">
                            <left>6</left><top>6</top>
                            <visible>Control.HasFocus(3100)</visible>
                            <control type="image">
                                <width>288</width><height>162</height>
                                <texture diffuse="silo/card_landscape_mask.png" colordiffuse="0FFFFFFF">colors/white.png</texture>
                            </control>
                            <control type="image">
                                <width>288</width><height>162</height>
                                <texture colordiffuse="33FFFFFF">silo/card_landscape_rim.png</texture>
                            </control>
                        </control>
                        <control type="group">
                            <left>244</left><top>16</top>
                            <visible>Integer.IsGreater(ListItem.PlayCount,0) | !String.IsEmpty(ListItem.Property(home.playcount))</visible>
                            <control type="image">
                                <width>40</width><height>40</height>
                                <texture colordiffuse="F2EDEDED">silo/avatar_mask.png</texture>
                            </control>
                            <control type="image">
                                <left>9</left><top>9</top><width>22</width><height>22</height>
                                <texture colordiffuse="FF000000">OverlayWatched.png</texture>
                            </control>
                        </control>
                        <control type="label">
                            <left>6</left><top>182</top>
                            <width>288</width><height>34</height>
                            <font>silo_card_title</font>
                            <textcolor>66EDEDED</textcolor>
                            <label>$VAR[SiloCardTitle]</label>
                            <visible>!Control.HasFocus(3100)</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>182</top>
                            <width>288</width><height>34</height>
                            <font>silo_card_title</font>
                            <textcolor>FFEDEDED</textcolor>
                            <label>$VAR[SiloCardTitle]</label>
                            <!-- The whole title, scrolling, on the focused card. -->
                            <scroll>true</scroll>
                            <scrollspeed>50</scrollspeed><scrollsuffix>      </scrollsuffix>
                            <visible>Control.HasFocus(3100)</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>216</top>
                            <width>288</width><height>32</height>
                            <font>silo_card_sub</font>
                            <textcolor>4AEDEDED</textcolor>
                            <label>$VAR[SiloCardEpisode]</label>
                            <visible>!Control.HasFocus(3100)</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>216</top>
                            <width>288</width><height>32</height>
                            <font>silo_card_sub</font>
                            <textcolor>FFEDEDED</textcolor>
                            <label>$VAR[SiloCardEpisode]</label>
                            <visible>Control.HasFocus(3100)</visible>
                        </control>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
