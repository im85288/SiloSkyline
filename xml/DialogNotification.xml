<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: a notice as Silo's TV apps draw one, a rounded panel in the
     player's Smoke colour with an icon and the message, top right under the
     menu bar. Kodi fills 400 (icon), 401 (heading) and 402 (message). -->
<window>
	<zorder>3</zorder>
	<controls>
		<control type="group">
			<depth>DepthMax</depth>
			<top>136</top>
			<right>96</right>
			<width>640</width>
			<height>128</height>
			<animation effect="fade" start="0" end="100" time="240">WindowOpen</animation>
			<animation effect="slide" start="40,0" end="0,0" time="240" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<visible>String.IsEmpty(Window(Home).Property(script.cinemavision.running))</visible>
			<control type="image">
				<width>640</width>
				<height>128</height>
				<texture border="14" colordiffuse="F4131417">silo/card_landscape_mask.png</texture>
			</control>
			<control type="image">
				<left>24</left>
				<top>24</top>
				<width>80</width>
				<height>80</height>
				<texture border="14" colordiffuse="1AFFFFFF">silo/card_landscape_mask.png</texture>
			</control>
			<control type="image" id="400">
				<description>icon</description>
				<left>36</left>
				<top>36</top>
				<width>56</width>
				<height>56</height>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="fadelabel" id="401">
				<description>heading</description>
				<left>124</left>
				<top>24</top>
				<width>492</width>
				<height>40</height>
				<font>silo_meta</font>
				<textcolor>FFEDEDED</textcolor>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
			<control type="fadelabel" id="402">
				<description>message</description>
				<left>124</left>
				<top>64</top>
				<width>492</width>
				<height>40</height>
				<font>silo_detail</font>
				<textcolor>99EDEDED</textcolor>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
		</control>
	</controls>
</window>
