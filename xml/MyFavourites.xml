<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_favourites.py: edit that, not this. -->
<window>
    <!-- Back from a video started here: stopped, as on Home and the other pages. -->
    <onload condition="Player.HasVideo">PlayerControl(Stop)</onload>
    <defaultcontrol always="true">50</defaultcontrol>
    <backgroundcolor>SkylineBackground</backgroundcolor>
    <views>50</views>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="SkylineBackground">colors/white.png</texture>
        </control>
        <include content="SiloFrame">
            <param name="title">$LOCALIZE[1036]</param>
            <param name="sub">$INFO[Container.NumItems,, items]</param>
        </include>
        <control type="panel" id="50">
            <left>82</left><top>200</top><width>1756</width><height>880</height>
            <orientation>vertical</orientation>
            <scrolltime tween="cubic" easing="out">280</scrolltime>
            <onleft>noop</onleft><onright>noop</onright>
            <itemlayout width="348" height="262">
                <control type="group">
                    <width>336</width><height>194</height>
                    <visible>!ListItem.IsParentFolder</visible>
                    <control type="image">
                        <left>6</left><top>6</top><width>324</width><height>182</height>
                        <texture diffuse="silo/card_landscape_mask.png" colordiffuse="FF1C1F24">colors/white.png</texture>
                    </control>
                    <control type="image">
                        <left>6</left><top>6</top><width>324</width><height>182</height>
                        <aspectratio>keep</aspectratio>
                        <texture background="true" diffuse="silo/card_landscape_mask.png">$INFO[ListItem.Icon]</texture>
                        <visible>!String.StartsWith(ListItem.Icon,Default)</visible>
                    </control>
                    <control type="image">
                        <left>120</left><top>49</top><width>96</width><height>96</height>
                        <aspectratio>keep</aspectratio>
                        <texture>$INFO[ListItem.Icon]</texture>
                        <visible>String.StartsWith(ListItem.Icon,Default)</visible>
                    </control>
                </control>
                <control type="label">
                    <left>6</left><top>200</top><width>324</width><height>34</height>
                    <aligny>center</aligny>
                    <font>silo_card_title</font>
                    <textcolor>66EDEDED</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>!ListItem.IsParentFolder</visible>
                </control>
            </itemlayout>
            <focusedlayout width="348" height="262">
                <control type="group">
                    <width>336</width><height>194</height>
                        <animation effect="zoom" start="100" end="110" time="180" tween="sine" easing="out" center="auto" condition="Control.HasFocus(50)">Conditional</animation>
                    <visible>!ListItem.IsParentFolder</visible>
                    <control type="image">
                        <left>6</left><top>6</top><width>324</width><height>182</height>
                        <texture diffuse="silo/card_landscape_mask.png" colordiffuse="FF1C1F24">colors/white.png</texture>
                    </control>
                    <control type="image">
                        <left>6</left><top>6</top><width>324</width><height>182</height>
                        <aspectratio>keep</aspectratio>
                        <texture background="true" diffuse="silo/card_landscape_mask.png">$INFO[ListItem.Icon]</texture>
                        <visible>!String.StartsWith(ListItem.Icon,Default)</visible>
                    </control>
                    <control type="image">
                        <left>120</left><top>49</top><width>96</width><height>96</height>
                        <aspectratio>keep</aspectratio>
                        <texture>$INFO[ListItem.Icon]</texture>
                        <visible>String.StartsWith(ListItem.Icon,Default)</visible>
                    </control>
                    <control type="group">
                        <left>6</left><top>6</top>
                        <visible>Control.HasFocus(50)</visible>
                        <control type="image">
                            <width>324</width><height>182</height>
                            <texture diffuse="silo/card_landscape_mask.png" colordiffuse="0FFFFFFF">colors/white.png</texture>
                        </control>
                        <control type="image">
                            <width>324</width><height>182</height>
                            <texture colordiffuse="33FFFFFF">silo/card_landscape_rim.png</texture>
                        </control>
                    </control>
                </control>
                <control type="label">
                    <left>6</left><top>200</top><width>324</width><height>34</height>
                    <aligny>center</aligny>
                    <font>silo_card_title</font>
                    <textcolor>FFEDEDED</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <scroll>true</scroll><scrollsuffix>     ·     </scrollsuffix>
                    <scrollspeed>50</scrollspeed>
                    <visible>!ListItem.IsParentFolder</visible>
                </control>
            </focusedlayout>
        </control>
        <control type="group">
            <left>88</left><top>200</top>
            <visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
            <control type="label">
                <width>1400</width><height>60</height>
                <font>silo_meta</font>
                <textcolor>FFEDEDED</textcolor>
                <label>No favourites yet</label>
            </control>
            <control type="label">
                <top>54</top><width>1400</width><height>44</height>
                <font>silo_detail</font>
                <textcolor>99EDEDED</textcolor>
                <label>Hold OK on anything in a list, then choose Add to favourites.</label>
            </control>
        </control>
    </controls>
</window>
