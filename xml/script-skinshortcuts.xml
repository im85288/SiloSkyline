<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: Skin Shortcuts' manager for the user's own menu items, in
     Silo's dialog style. Skin Shortcuts fills list 211 and acts on the buttons
     by id: 301 add, 302 delete, 303/304 move, 305 rename, 401 choose what the
     item opens, 312 choose a widget (widgetID picks widget 2-4), 308 reset. -->
<window>
	<defaultcontrol always="true">211</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="B3000000">colors/white.png</texture>
		</control>
		<control type="group">
			<left>260</left><top>130</top>
			<width>1400</width><height>820</height>
			<control type="image">
				<width>1400</width><height>820</height>
				<texture border="14" colordiffuse="F4131417">silo/card_landscape_mask.png</texture>
			</control>
			<control type="label">
				<left>48</left><top>28</top>
				<width>1300</width><height>56</height>
				<aligny>center</aligny>
				<font>silo_row</font>
				<textcolor>FFEDEDED</textcolor>
				<label>Customise menu</label>
			</control>
			<control type="label">
				<left>48</left><top>80</top>
				<width>1300</width><height>36</height>
				<aligny>center</aligny>
				<font>silo_detail</font>
				<textcolor>99EDEDED</textcolor>
				<label>Your items sit beside the avatar. An item with widgets shows them as rows on its own page.</label>
			</control>

			<!-- The items. -->
			<control type="list" id="211">
				<left>36</left><top>140</top>
				<width>560</width><height>640</height>
				<orientation>vertical</orientation>
				<onright>9000</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<itemlayout width="560" height="80">
					<control type="label">
						<left>24</left><top>8</top><width>512</width><height>36</height>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>24</left><top>42</top><width>512</width><height>30</height>
						<font>silo_detail</font>
						<textcolor>99EDEDED</textcolor>
						<label>$VAR[SiloShortcutDetail]</label>
					</control>
				</itemlayout>
				<focusedlayout width="560" height="80">
					<control type="image">
						<width>560</width><height>80</height>
						<texture border="46" colordiffuse="FFEDEDED">silo/dialog_button.png</texture>
						<visible>Control.HasFocus(211)</visible>
					</control>
					<control type="image">
						<width>560</width><height>80</height>
						<texture border="46" colordiffuse="2EFFFFFF">silo/dialog_button.png</texture>
						<visible>!Control.HasFocus(211)</visible>
					</control>
					<control type="label">
						<left>24</left><top>8</top><width>512</width><height>36</height>
						<font>silo_meta</font>
						<textcolor>FF000000</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(211)</visible>
					</control>
					<control type="label">
						<left>24</left><top>8</top><width>512</width><height>36</height>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(211)</visible>
					</control>
					<control type="label">
						<left>24</left><top>42</top><width>512</width><height>30</height>
						<font>silo_detail</font>
						<textcolor>B3000000</textcolor>
						<label>$VAR[SiloShortcutDetail]</label>
						<visible>Control.HasFocus(211)</visible>
					</control>
					<control type="label">
						<left>24</left><top>42</top><width>512</width><height>30</height>
						<font>silo_detail</font>
						<textcolor>99EDEDED</textcolor>
						<label>$VAR[SiloShortcutDetail]</label>
						<visible>!Control.HasFocus(211)</visible>
					</control>
				</focusedlayout>
			</control>
			<control type="label">
				<left>60</left><top>160</top>
				<width>520</width><height>120</height>
				<font>silo_meta</font>
				<textcolor>99EDEDED</textcolor>
				<label>No items yet: choose Add.</label>
				<visible>!Integer.IsGreater(Container(211).NumItems,0)</visible>
			</control>

			<!-- What to do with the selected item. -->
			<control type="grouplist" id="9000">
				<left>630</left><top>140</top>
				<width>734</width><height>660</height>
				<orientation>vertical</orientation>
				<itemgap>-8</itemgap>
				<onleft>211</onleft>
				<control type="button" id="301">
					<include>SiloShortcutButton</include>
					<label>Add an item</label>
				</control>
				<control type="button" id="401">
					<include>SiloShortcutButton</include>
					<label>Opens</label>
					<label2>$INFO[Container(211).ListItem.Label2]</label2>
				</control>
				<control type="button" id="305">
					<include>SiloShortcutButton</include>
					<label>Rename</label>
				</control>
				<control type="button" id="9451">
					<include>SiloShortcutButton</include>
					<label>Widget 1</label>
					<label2>$VAR[SiloShortcutWidget1]</label2>
					<onclick>SendClick(312)</onclick>
				</control>
				<control type="button" id="9452">
					<include>SiloShortcutButton</include>
					<label>Widget 2</label>
					<label2>$VAR[SiloShortcutWidget2]</label2>
					<onclick>SetProperty(widgetID,2)</onclick>
					<onclick>SendClick(312)</onclick>
				</control>
				<control type="button" id="9453">
					<include>SiloShortcutButton</include>
					<label>Widget 3</label>
					<label2>$VAR[SiloShortcutWidget3]</label2>
					<onclick>SetProperty(widgetID,3)</onclick>
					<onclick>SendClick(312)</onclick>
				</control>
				<control type="button" id="9454">
					<include>SiloShortcutButton</include>
					<label>Widget 4</label>
					<label2>$VAR[SiloShortcutWidget4]</label2>
					<onclick>SetProperty(widgetID,4)</onclick>
					<onclick>SendClick(312)</onclick>
				</control>
				<control type="button" id="303">
					<include>SiloShortcutButton</include>
					<label>Move up</label>
				</control>
				<control type="button" id="304">
					<include>SiloShortcutButton</include>
					<label>Move down</label>
				</control>
				<control type="button" id="302">
					<include>SiloShortcutButton</include>
					<label>Delete</label>
				</control>
			</control>
			<!-- Skin Shortcuts' widget chooser, clicked by the Widget buttons. -->
			<control type="button" id="312">
				<left>-3000</left><top>0</top><width>10</width><height>10</height>
				<texturefocus /><texturenofocus />
			</control>
		</control>
	</controls>
</window>
