<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<onload condition="String.IsEmpty(Skin.String(background_overlay))">Skin.SetString(background_overlay,1)</onload>
	<controls>
		<include>SiloPage</include>
		<!-- Silo Skyline frame (tools/build_frame.py) -->
		<include>SiloPanel</include>
		<control type="image">
			<left>554</left><top>228</top><width>2</width><height>756</height>
			<texture colordiffuse="14FFFFFF">colors/white.png</texture>
		</control>
		<control type="label">
			<left>580</left><top>222</top><width>1212</width><height>56</height>
			<font>silo_row</font>
			<textcolor>FFEDEDED</textcolor>
			<label>$INFO[Container(9000).ListItem.Label]</label>
		</control>
		<control type="image">
			<left>580</left><top>354</top><width>1212</width><height>2</height>
			<texture colordiffuse="14FFFFFF">colors/white.png</texture>
		</control>
		<control type="group" id="10000">
			<left>556</left><width>1236</width>
			<include>OpenClose_Right</include>
			<control type="grouplist" id="700">
				<top>366</top>
				<left>0</left>
				<right>0</right>
				<height>630</height>
				<onleft>9000</onleft>
				<onright>60</onright>
				<onup>700</onup>
				<ondown>700</ondown>
				<visible>Container(9000).HasFocus(1)</visible>
				<!-- Skyline look (tools/build_frame.py) -->
				<control type="button" id="790">
					<label>Colours</label>
					<label2>$VAR[SkylineColourName]</label2>
					<include>DefaultSettingButton</include>
					<onclick>ActivateWindow(InterfaceSettings)</onclick>
				</control>
				<control type="button" id="792">
					<label>Recommended add-ons</label>
					<label2>Up Next, YouTube and more</label2>
					<include>DefaultSettingButton</include>
					<onclick>ActivateWindow(1192)</onclick>
				</control>
				<control type="radiobutton" id="791">
					<label>Artwork background</label>
					<include>DefaultSettingButton</include>
					<selected>Skin.HasSetting(SkylineArtworkBackground)</selected>
					<onclick>Skin.ToggleSetting(SkylineArtworkBackground)</onclick>
				</control>
				<control type="radiobutton" id="701">
					<label>$LOCALIZE[31095]</label>
					<include>DefaultSettingButton</include>
					<selected>!Skin.HasSetting(no_slide_animations)</selected>
					<onclick>Skin.ToggleSetting(no_slide_animations)</onclick>
				</control>
			</control>
			<control type="grouplist" id="622">
				<top>366</top>
				<left>0</left>
				<right>0</right>
				<height>630</height>
				<onleft>9000</onleft>
				<onright>60</onright>
				<onup>622</onup>
				<pagecontrol>60</pagecontrol>
				<ondown>622</ondown>
				<visible>Container(9000).HasFocus(4)</visible>
<!-- Silo Skyline player style (tools/build_showcase.py) -->
				<control type="button" id="793">
					<label>Player style</label>
					<label2>$VAR[SkylinePlayerStyle]</label2>
					<include>DefaultSettingButton</include>
					<onclick>Skin.ToggleSetting(SkylineSiloOSD)</onclick>
				</control>
				<!-- end Silo Skyline player style -->				<control type="radiobutton" id="623">
					<label>$LOCALIZE[31172]</label>
					<include>DefaultSettingButton</include>
					<selected>Skin.HasSetting(OSDAutoClose)</selected>
					<onclick>Skin.ToggleSetting(OSDAutoClose)</onclick>
				</control>
				<control type="button" id="624">
					<label>- $LOCALIZE[31173]</label>
					<label2>$VAR[SkinSettingOSDAutoCloseTime]</label2>
					<include>DefaultSettingButton</include>
					<onclick>Skin.SetNumeric(OSDAutoCloseTime)</onclick>
					<enable>Skin.HasSetting(OSDAutoClose)</enable>
				</control>
			</control>
		</control>
		<control type="group">
			<depth>DepthContentPanel</depth>
			<left>0</left>
			<include>OpenClose_Left</include>
			<control type="list" id="9000">
				<description>button area</description>
				<left>106</left><top>218</top><width>434</width><height>776</height>
				<onleft>10000</onleft>
				<onright>10000</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<itemlayout height="70" width="434">
					<control type="label">
						<textoffsetx>32</textoffsetx>
						<width>434</width><height>70</height>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout height="70" width="434">
					<control type="image">
						<width>434</width><height>70</height>
						<texture border="30" colordiffuse="SkylineFocus">silo/card_landscape_mask.png</texture>
						<animation effect="fade" start="100" end="40" time="100" condition="!Control.HasFocus(9000)">Conditional</animation>
					</control>
					<control type="label">
						<textoffsetx>32</textoffsetx>
						<width>434</width><height>70</height>
						<font>silo_meta</font>
						<textcolor>SkylineFocusText</textcolor>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
				<content>
					<item id="1">
						<label>$LOCALIZE[128]</label>
						<onclick>noop</onclick>
					</item>
					<item id="4">
						<label>Player</label>
						<onclick>noop</onclick>
					</item>
				</content>
			</control>
		</control>
		<control type="group">
			<right>0</right>
			<top>366</top>
			<bottom>137</bottom>
			<width>60</width>
			<control type="scrollbar" id="60">
				<right>0</right>
				<top>0</top>
				<bottom>0</bottom>
				<width>12</width>
				<orientation>vertical</orientation>
				<texturesliderbackground />
				<animation effect="slide" end="6,0" time="300" tween="sine" easing="inout" condition="!Control.HasFocus(60)">conditional</animation>
				<onleft>622</onleft>
				<onright>622</onright>
				<animation effect="fade" start="0" end="100" time="200" delay="300">Visible</animation>
				<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
				<animation effect="fade" start="0" end="100" delay="300" time="320">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
				<hitrect x="0" y="0" w="60" h="100%" />
				<visible>Control.IsVisible(622)</visible>
			</control>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="$LOCALIZE[5] / $LOCALIZE[20077]" />
		</include>
		<control type="textbox" id="6">
			<include>OpenClose_Right</include>
			<description>description area</description>
			<left>580</left><top>280</top><width>1212</width><height>66</height>
			<font>silo_detail</font>
			<textcolor>BFEDEDED</textcolor>
			<label>$VAR[SkinSettingsHelpTextVar]</label>
			<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
		</control>
	</controls>
</window>
