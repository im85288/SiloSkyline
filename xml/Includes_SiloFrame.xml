<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_frame.py: edit that, not this. -->
<includes>
	<!-- The header (mark, title, facts) and the clock every screen shares. -->
	<include name="SiloFrame">
		<param name="title"></param>
		<param name="sub">$INFO[Window(Home).Property(silo.library.facts)]</param>
		<definition>
			<control type="group">
				<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
				<control type="image">
					<left>88</left><top>58</top><width>64</width><height>64</height>
					<texture>silo/skyline_mark.png</texture>
				</control>
				<control type="label">
					<left>170</left><top>50</top><width>1300</width><height>58</height>
					<aligny>center</aligny>
					<font>silo_wordmark</font>
					<textcolor>FFEDEDED</textcolor>
					<label>$PARAM[title]</label>
				</control>
				<control type="label">
					<left>170</left><top>106</top><width>1300</width><height>36</height>
					<aligny>center</aligny>
					<font>silo_detail</font>
					<textcolor>BFEDEDED</textcolor>
					<label>$PARAM[sub]</label>
				</control>
			</control>
			<include>SiloClock</include>
		</definition>
	</include>
	<include name="SiloClock">
		<control type="group">
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<control type="label">
				<left>1232</left><top>46</top><width>600</width><height>66</height>
				<align>right</align><aligny>center</aligny>
				<font>silo_clock</font>
				<textcolor>FFEDEDED</textcolor>
				<label>$INFO[System.Time]</label>
			</control>
			<control type="label">
				<left>1232</left><top>106</top><width>600</width><height>36</height>
				<align>right</align><aligny>center</aligny>
				<font>silo_detail</font>
				<textcolor>BFEDEDED</textcolor>
				<label>$INFO[System.Date]</label>
			</control>
		</control>
	</include>
	<!-- The rounded panel a screen's content sits in. -->
	<include name="SiloPanel">
		<param name="left">88</param>
		<param name="top">196</param>
		<param name="width">1744</param>
		<param name="height">820</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left><top>$PARAM[top]</top>
				<width>$PARAM[width]</width><height>$PARAM[height]</height>
				<texture border="24" colordiffuse="SkylinePanel">silo/card_landscape_mask.png</texture>
			</control>
		</definition>
	</include>
	<!-- The colour theme's name: Kodi calls the default SKINDEFAULT. -->
	<variable name="SkylineColourName">
		<value condition="String.IsEqual(Skin.CurrentColourTheme,SKINDEFAULT)">Silo</value>
		<value>$INFO[Skin.CurrentColourTheme]</value>
	</variable>
	<!-- Over a window while a trailer from its info page starts and on the way
	     back to that page (silokodi.trailer_playing): the title's fanart and a
	     spinner, never the grid or rows under the page. -->
	<include name="SiloTrailerCover">
		<control type="group">
			<!-- Up until the page is back (it clears the flag as it opens);
			     SiloKodiConnect clears it after a few seconds if it isn't. -->
			<visible>!String.IsEmpty(Window(Home).Property(silokodi.trailer_playing))</visible>
			<control type="image">
				<left>0</left><top>0</top><width>1920</width><height>1080</height>
				<texture colordiffuse="SkylineBackground">colors/white.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>1920</width><height>1080</height>
				<aspectratio>scale</aspectratio>
				<texture background="true" colordiffuse="59FFFFFF">$INFO[Window(Home).Property(silokodi.trailer_art)]</texture>
			</control>
			<control type="image">
				<left>928</left><top>508</top><width>64</width><height>64</height>
				<texture colordiffuse="FFEDEDED">silo/spinner_arc.png</texture>
				<animation effect="rotate" start="0" end="-360" center="auto" time="900" loop="true" condition="true">Conditional</animation>
			</control>
		</control>
	</include>
	<!-- The event log's count, "1 event" or "12 events". -->
	<variable name="SiloEventCount">
		<value condition="Integer.IsEqual(Container(50).NumItems,1)">1 event</value>
		<value>$INFO[Container(50).NumItems,, events]</value>
	</variable>
	<!-- Silo's page colour behind a screen, and with Skin settings' Artwork
	     background (as Arctic Zephyr) the focused title's fanart, dimmed. -->
	<include name="SiloPage">
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<texture colordiffuse="SkylineBackground">colors/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>1920</width><height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true" colordiffuse="38FFFFFF">$INFO[Container.ListItem.Art(fanart)]</texture>
			<visible>Skin.HasSetting(SkylineArtworkBackground)</visible>
		</control>
	</include>
</includes>
