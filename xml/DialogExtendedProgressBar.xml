<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: background progress (library scans, SiloKodiConnect's sync)
     as a Silo notice, top right under the menu bar: the task, its detail and
     a thin bar. Kodi fills 30 (heading), 31 (detail) and 32 (progress). -->
<window>
	<zorder>3</zorder>
	<animation effect="fade" start="0" end="100" time="240">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<control type="group">
			<depth>DepthBars</depth>
			<top>136</top>
			<right>96</right>
			<width>560</width>
			<height>128</height>
			<!-- Below a notification when both show. -->
			<animation effect="slide" end="0,144" time="200" condition="Window.IsVisible(notification)">Conditional</animation>
			<control type="image">
				<width>560</width>
				<height>128</height>
				<texture border="14" colordiffuse="F4131417">silo/card_landscape_mask.png</texture>
			</control>
			<control type="label" id="30">
				<left>28</left>
				<top>20</top>
				<width>420</width>
				<height>40</height>
				<font>silo_meta</font>
				<textcolor>FFEDEDED</textcolor>
				<aligny>center</aligny>
			</control>
			<control type="label">
				<left>440</left>
				<top>20</top>
				<width>92</width>
				<height>40</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>silo_detail</font>
				<textcolor>99EDEDED</textcolor>
				<label>$INFO[Control.GetLabel(32),,%]</label>
			</control>
			<control type="label" id="31">
				<left>28</left>
				<top>58</top>
				<width>504</width>
				<height>34</height>
				<font>silo_detail</font>
				<textcolor>99EDEDED</textcolor>
				<aligny>center</aligny>
			</control>
			<control type="progress" id="32">
				<left>28</left>
				<top>102</top>
				<width>504</width>
				<height>6</height>
				<texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
				<midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
			</control>
		</control>
	</controls>
</window>
