<includes>
    <include name="SiloHomeCard">
        <param name="p" />
        <definition>
            <item>
                <label>$INFO[Window(Home).Property($PARAM[p].label)]</label>
                <property name="home.type">$INFO[Window(Home).Property($PARAM[p].type)]</property>
                <property name="home.dbid">$INFO[Window(Home).Property($PARAM[p].dbid)]</property>
                <property name="home.card.title">$INFO[Window(Home).Property($PARAM[p].card.title)]</property>
