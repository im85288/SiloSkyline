<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_home.py: Silo's cards, shared by every row. -->
<includes>
    <include name="SiloCardPoster">
                    <control type="group">
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>176</width><height>264</height>
                            <texture background="true" diffuse="silo/card_poster_mask.png" fallback="colors/grey.png">$VAR[SiloPosterArt]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>176</width><height>264</height>
                            <texture diffuse="silo/card_poster_mask.png">silo/card_scrim.png</texture>
                        </control>
                        <control type="progress">
                            <left>18</left><top>264</top>
                            <width>152</width><height>6</height>
                            <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                            <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                            <info>ListItem.PercentPlayed</info>
                            <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                        </control>
                        <control type="image">
                            <right>16</right><top>16</top>
                            <width>32</width><height>32</height>
                            <texture colordiffuse="FFEDEDED">OverlayWatched.png</texture>
                            <visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>284</top>
                            <width>176</width><height>34</height>
                            <font>silo_card_title</font>
                            <textcolor>C7EDEDED</textcolor>
                            <label>$VAR[SiloCardTitle]</label>
                        </control>
                        <control type="label">
                            <left>6</left><top>318</top>
                            <width>176</width><height>32</height>
                            <font>silo_card_sub</font>
                            <textcolor>BFEDEDED</textcolor>
                            <label>$VAR[SiloCardYear]</label>
                        </control>
                    </control>
    </include>
    <include name="SiloCardFocusedPoster">
        <param name="id" />
        <definition>
                    <control type="group">
                        <animation effect="zoom" start="100" end="104" time="160" tween="sine" center="auto" condition="Control.HasFocus($PARAM[id])">Conditional</animation>
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>176</width><height>264</height>
                            <texture background="true" diffuse="silo/card_poster_mask.png" fallback="colors/grey.png">$VAR[SiloPosterArt]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>
                        <control type="image">
                            <left>6</left><top>6</top>
                            <width>176</width><height>264</height>
                            <texture diffuse="silo/card_poster_mask.png">silo/card_scrim.png</texture>
                        </control>
                        <control type="progress">
                            <left>18</left><top>264</top>
                            <width>152</width><height>6</height>
                            <texturebg colordiffuse="33FFFFFF">colors/white.png</texturebg>
                            <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                            <info>ListItem.PercentPlayed</info>
                            <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                        </control>
                        <control type="image">
                            <right>16</right><top>16</top>
                            <width>32</width><height>32</height>
                            <texture colordiffuse="FFEDEDED">OverlayWatched.png</texture>
                            <visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
                        </control>
                        <control type="image">
                            <left>0</left><top>0</top>
                            <width>188</width><height>276</height>
                            <texture colordiffuse="FFEDEDED">silo/card_poster_focus.png</texture>
                            <visible>Control.HasFocus($PARAM[id])</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>284</top>
                            <width>176</width><height>34</height>
                            <font>silo_card_title</font>
                            <textcolor>C7EDEDED</textcolor>
                            <label>$VAR[SiloCardTitle]</label>
                            <visible>!Control.HasFocus($PARAM[id])</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>284</top>
                            <width>176</width><height>34</height>
                            <font>silo_card_title</font>
                            <textcolor>FFEDEDED</textcolor>
                            <label>$VAR[SiloCardTitle]</label>
                            <!-- The whole title, scrolling, on the focused card. -->
                            <scroll>true</scroll>
                            <scrollspeed>50</scrollspeed><scrollsuffix>      </scrollsuffix>
                            <visible>Control.HasFocus($PARAM[id])</visible>
                        </control>
                        <control type="label">
                            <left>6</left><top>318</top>
                            <width>176</width><height>32</height>
                            <font>silo_card_sub</font>
                            <textcolor>BFEDEDED</textcolor>
                            <label>$VAR[SiloCardYear]</label>
                        </control>
                    </control>
        </definition>
    </include>
