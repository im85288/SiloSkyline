<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: the power menu as a Silo-style sheet under the bar's power
     button: one rounded card, the focused row a white pill. The actions are
     Estuary's, plus Arctic Zephyr's quick tools. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<left>1010</left><top>136</top>
			<width>480</width>
			<!-- One card behind the rows, sized to however many show, as Silo's sheets. -->
			<control type="image">
				<width>480</width><height>96</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,1)</visible>
			</control>
			<control type="image">
				<width>480</width><height>164</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,2)</visible>
			</control>
			<control type="image">
				<width>480</width><height>232</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,3)</visible>
			</control>
			<control type="image">
				<width>480</width><height>300</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,4)</visible>
			</control>
			<control type="image">
				<width>480</width><height>368</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,5)</visible>
			</control>
			<control type="image">
				<width>480</width><height>436</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,6)</visible>
			</control>
			<control type="image">
				<width>480</width><height>504</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,7)</visible>
			</control>
			<control type="image">
				<width>480</width><height>572</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,8)</visible>
			</control>
			<control type="image">
				<width>480</width><height>640</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,9)</visible>
			</control>
			<control type="image">
				<width>480</width><height>708</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,10)</visible>
			</control>
			<control type="image">
				<width>480</width><height>776</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,11)</visible>
			</control>
			<control type="image">
				<width>480</width><height>844</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,12)</visible>
			</control>
			<control type="image">
				<width>480</width><height>912</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,13)</visible>
			</control>
			<control type="image">
				<width>480</width><height>980</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,14)</visible>
			</control>
			<control type="image">
				<width>480</width><height>1048</height>
				<texture border="24" colordiffuse="F21C1F24">silo/card_landscape_mask.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,15)</visible>
			</control>
			<control type="list" id="9000">
				<left>0</left><top>14</top>
				<width>480</width><height>1020</height>
				<orientation>vertical</orientation>
				<itemlayout width="480" height="68">
					<control type="label">
						<left>40</left><width>400</width><height>68</height>
						<aligny>center</aligny>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="480" height="68">
					<control type="image">
						<left>14</left><top>4</top>
						<width>452</width><height>60</height>
						<texture border="30" colordiffuse="FFEDEDED">silo/pill.png</texture>
						<visible>Control.HasFocus(9000)</visible>
					</control>
					<control type="label">
						<left>40</left><width>400</width><height>68</height>
						<aligny>center</aligny>
						<font>silo_meta</font>
						<textcolor>FF000000</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(9000)</visible>
					</control>
					<control type="label">
						<left>40</left><width>400</width><height>68</height>
						<aligny>center</aligny>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(9000)</visible>
					</control>
				</focusedlayout>
				<content>
					<item>
						<label>$LOCALIZE[13012]</label>
						<onclick>Quit()</onclick>
						<visible>System.ShowExitButton</visible>
					</item>
					<!-- Silo Skyline: quick tools, as Arctic Zephyr's power menu has them. -->
					<item>
						<label>Reload skin</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ReloadSkin()</onclick>
					</item>
					<item>
						<label>$LOCALIZE[20077]</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(SkinSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[130]</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(SystemInfo)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[7]</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(FileManager)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[5]</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(Settings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13016]</label>
						<onclick>Powerdown()</onclick>
						<visible>System.CanPowerDown</visible>
					</item>
					<item>
						<label>$LOCALIZE[20150]</label>
						<onclick>AlarmClock(shutdowntimer,Shutdown())</onclick>
						<visible>!System.HasAlarm(shutdowntimer)</visible>
						<visible>System.CanPowerDown | System.CanSuspend | System.CanHibernate</visible>
					</item>
					<item>
						<label>$LOCALIZE[20151] $INFO[System.AlarmPos,(,)]</label>
						<onclick>CancelAlarm(shutdowntimer)</onclick>
						<visible>System.HasAlarm(shutdowntimer)</visible>
					</item>
					<item>
						<label>$LOCALIZE[13011]</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>Suspend()</onclick>
						<visible>System.CanSuspend</visible>
					</item>
					<item>
						<label>$LOCALIZE[13010]</label>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>Hibernate()</onclick>
						<visible>System.CanHibernate</visible>
					</item>
					<item>
						<label>$LOCALIZE[13013]</label>
						<onclick>Reset()</onclick>
						<visible>System.CanReboot</visible>
					</item>
					<item>
						<label>$LOCALIZE[20126] $INFO[system.profilename]</label>
						<onclick>dialog.close(all,true)</onclick>
						<onclick>System.LogOff</onclick>
						<visible>System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)</visible>
						<visible>System.Loggedon</visible>
					</item>
					<item>
						<label>$VAR[MasterModeLabel]</label>
						<onclick>mastermode</onclick>
						<visible>System.HasLocks</visible>
					</item>
					<item>
						<label>$LOCALIZE[13017]</label>
						<onclick>InhibitIdleShutdown(true)</onclick>
						<visible>System.HasShutdown +!System.IdleShutdownInhibited</visible>
					</item>
					<item>
						<label>$LOCALIZE[13018]</label>
						<onclick>InhibitIdleShutdown(false)</onclick>
						<visible>System.HasShutdown + System.IdleShutdownInhibited</visible>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
