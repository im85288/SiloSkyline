<?xml version="1.0" encoding="UTF-8"?>
<!-- Silo Skyline: the power menu as Silo's Apple TV menus, under the bar's
     power button: a glass panel, each row an icon and its name, the focused
     row a white bar. The actions are Estuary's, plus Arctic Zephyr's quick tools. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<!-- Under the bar's power button, its right edge with the button's. -->
			<left>1200</left><top>136</top>
			<width>520</width>
			<!-- Silo's Apple TV menu: a glass panel behind the rows, sized to however many show. -->
			<control type="image">
				<width>520</width><height>88</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,1)</visible>
			</control>
			<control type="image">
				<width>520</width><height>152</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,2)</visible>
			</control>
			<control type="image">
				<width>520</width><height>216</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,3)</visible>
			</control>
			<control type="image">
				<width>520</width><height>280</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,4)</visible>
			</control>
			<control type="image">
				<width>520</width><height>344</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,5)</visible>
			</control>
			<control type="image">
				<width>520</width><height>408</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,6)</visible>
			</control>
			<control type="image">
				<width>520</width><height>472</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,7)</visible>
			</control>
			<control type="image">
				<width>520</width><height>536</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,8)</visible>
			</control>
			<control type="image">
				<width>520</width><height>600</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,9)</visible>
			</control>
			<control type="image">
				<width>520</width><height>664</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,10)</visible>
			</control>
			<control type="image">
				<width>520</width><height>728</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,11)</visible>
			</control>
			<control type="image">
				<width>520</width><height>792</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,12)</visible>
			</control>
			<control type="image">
				<width>520</width><height>856</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,13)</visible>
			</control>
			<control type="image">
				<width>520</width><height>920</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,14)</visible>
			</control>
			<control type="image">
				<width>520</width><height>984</height>
				<texture border="28">silo/menu_panel.png</texture>
				<visible>Integer.IsEqual(Container(9000).NumItems,15)</visible>
			</control>
			<control type="list" id="9000">
				<left>12</left><top>12</top>
				<width>496</width><height>960</height>
				<orientation>vertical</orientation>
				<itemlayout width="496" height="64">
					<control type="image">
						<left>28</left><top>16</top><width>32</width><height>32</height>
						<texture colordiffuse="FFEDEDED">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>80</left><width>392</width><height>64</height>
						<aligny>center</aligny>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="496" height="64">
					<!-- The focused row: a white rounded bar, as Silo's menus. -->
					<control type="image">
						<width>496</width><height>64</height>
						<texture border="20" colordiffuse="SkylineFocus">silo/card_landscape_mask.png</texture>
						<visible>Control.HasFocus(9000)</visible>
					</control>
					<control type="image">
						<left>28</left><top>16</top><width>32</width><height>32</height>
						<texture colordiffuse="SkylineFocusText">$INFO[ListItem.Icon]</texture>
						<visible>Control.HasFocus(9000)</visible>
					</control>
					<control type="label">
						<left>80</left><width>392</width><height>64</height>
						<aligny>center</aligny>
						<font>silo_meta</font>
						<textcolor>SkylineFocusText</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>Control.HasFocus(9000)</visible>
					</control>
					<control type="image">
						<left>28</left><top>16</top><width>32</width><height>32</height>
						<texture colordiffuse="FFEDEDED">$INFO[ListItem.Icon]</texture>
						<visible>!Control.HasFocus(9000)</visible>
					</control>
					<control type="label">
						<left>80</left><width>392</width><height>64</height>
						<aligny>center</aligny>
						<font>silo_meta</font>
						<textcolor>FFEDEDED</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!Control.HasFocus(9000)</visible>
					</control>
				</focusedlayout>
				<content>
					<item>
						<label>$LOCALIZE[13012]</label>
						<icon>icons/back.png</icon>
						<onclick>Quit()</onclick>
						<visible>System.ShowExitButton</visible>
					</item>
					<!-- Silo Skyline: quick tools, as Arctic Zephyr's power menu has them. -->
					<item>
						<label>Reload skin</label>
						<icon>icons/infodialogs/update.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ReloadSkin()</onclick>
					</item>
					<item>
						<label>$LOCALIZE[20077]</label>
						<icon>icons/infodialogs/configure.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(SkinSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[130]</label>
						<icon>icons/infodialogs/info.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(SystemInfo)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[7]</label>
						<icon>icons/filemanager.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(FileManager)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[5]</label>
						<icon>icons/settings.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>ActivateWindow(Settings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13016]</label>
						<icon>icons/power.png</icon>
						<onclick>Powerdown()</onclick>
						<visible>System.CanPowerDown</visible>
					</item>
					<item>
						<label>$LOCALIZE[20150]</label>
						<icon>icons/infodialogs/timer.png</icon>
						<onclick>AlarmClock(shutdowntimer,Shutdown())</onclick>
						<visible>!System.HasAlarm(shutdowntimer)</visible>
						<visible>System.CanPowerDown | System.CanSuspend | System.CanHibernate</visible>
					</item>
					<item>
						<label>$LOCALIZE[20151] $INFO[System.AlarmPos,(,)]</label>
						<icon>icons/infodialogs/timer.png</icon>
						<onclick>CancelAlarm(shutdowntimer)</onclick>
						<visible>System.HasAlarm(shutdowntimer)</visible>
					</item>
					<item>
						<label>$LOCALIZE[13011]</label>
						<icon>icons/power.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>Suspend()</onclick>
						<visible>System.CanSuspend</visible>
					</item>
					<item>
						<label>$LOCALIZE[13010]</label>
						<icon>icons/power.png</icon>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>Hibernate()</onclick>
						<visible>System.CanHibernate</visible>
					</item>
					<item>
						<label>$LOCALIZE[13013]</label>
						<icon>icons/infodialogs/update.png</icon>
						<onclick>Reset()</onclick>
						<visible>System.CanReboot</visible>
					</item>
					<item>
						<label>$LOCALIZE[20126] $INFO[system.profilename]</label>
						<icon>silo/menu_profile.png</icon>
						<onclick>dialog.close(all,true)</onclick>
						<onclick>System.LogOff</onclick>
						<visible>System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)</visible>
						<visible>System.Loggedon</visible>
					</item>
					<item>
						<label>$VAR[MasterModeLabel]</label>
						<icon>icons/infodialogs/configure.png</icon>
						<onclick>mastermode</onclick>
						<visible>System.HasLocks</visible>
					</item>
					<item>
						<label>$LOCALIZE[13017]</label>
						<icon>icons/infodialogs/timer.png</icon>
						<onclick>InhibitIdleShutdown(true)</onclick>
						<visible>System.HasShutdown +!System.IdleShutdownInhibited</visible>
					</item>
					<item>
						<label>$LOCALIZE[13018]</label>
						<icon>icons/infodialogs/timer.png</icon>
						<onclick>InhibitIdleShutdown(false)</onclick>
						<visible>System.HasShutdown + System.IdleShutdownInhibited</visible>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
